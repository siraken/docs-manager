#!/bin/bash
set -Ceux

FILENAME=$0
ARGS=${@:2}

DC="docker compose"
SAIL="./vendor/bin/sail"
SSH_NAME="novalumo-bitnami"

case $1 in
"init")
    cp ./env.example .env
    $SAIL up
;;
"up")
    $SAIL up
;;
"down")
    $SAIL down
;;
"build")
    $SAIL build $ARGS
;;
"composer")
    $SAIL composer $ARGS
;;
"artisan")
    $SAIL artisan $ARGS
;;
"npx")
    $SAIL npx $ARGS
;;
"npm")
    $SAIL npm $ARGS
;;
"yarn")
    $SAIL yarn $ARGS
;;
"test")
    $FILENAME test:php
    $FILENAME test:js
;;
"test:php")
    $SAIL test ${ARGS}
;;
"test:js")
    $FILENAME yarn test
;;
"db:reset")
    $SAIL artisan migrate:reset
    $SAIL artisan migrate
    $SAIL artisan db:seed
;;
"prod:migrate")
    ssh $SSH_NAME "cd ~/repos/docs-manager/ && php artisan migrate:fresh"
;;
"composer:init")
    docker run --rm \
        -u "$(id -u):$(id -g)" \
        -v $(pwd):/var/www/html \
        -w /var/www/html \
        laravelsail/php74-composer:latest \
        composer install --ignore-platform-reqs
;;
*)
    echo Unexpected command.
;;
esac
