APP_NAME=docs-manager
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

FREEE_API_ENDPOINT=https://api.freee.co.jp/
FREEE_API_CLIENT_ID=
FREEE_API_CLIENT_SECRET=
FREEE_API_WEB_AUTH_URL=
FREEE_API_MOBILE_AUTH_URL=
FREEE_API_TOKEN=
FREEE_API_REFRESH_TOKEN=
FREEE_API_COMPANY_ID=

CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_SPREADSHEET_ID=

# 案件の Jira キーからリンクを組む先。API は叩かない
JIRA_BROWSE_URL=https://novalumo.atlassian.net/browse/

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_ENV="${APP_ENV}"
